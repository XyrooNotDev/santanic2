<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Izin Akses Internet -->
    <uses-permission android:name="android.permission.INTERNET" />
    
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Santanic Build"
        android:supportsRtl="true"
        android:theme="@style/Theme.SantanicBuild"> <!-- Pastikan themes.xml ada -->
        
        <!-- Halaman Login -->
        <activity android:name=".LoginActivity" android:exported="true">
            <!-- Membuka Aplikasi -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            
            <!-- TAMBAHAN: Menangkap Redirect dari GitHub (santanic://callback) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                
                <data android:scheme="santanic" android:host="callback" />
            </intent-filter>
        </activity>
        
        <!-- Halaman Lainnya -->
        <activity android:name=".MainActivity" />
        <activity android:name=".BuildActivity" />
        <activity android:name=".HistoryActivity" />
        
    </application>

</manifest>
